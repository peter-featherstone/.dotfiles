PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar position=top padding_left=5 padding_right=5 height=40 blur_radius=30 color=0xff1e1e2e

default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding Left Items #####
sketchybar --add event aerospace_workspace_change

# Workspace 0 sits after 9 on the keyboard, so show it last and label it 10
for sid in $(aerospace list-workspaces --all | grep -v '^0$') 0; do
    label=$([ "$sid" = "0" ] && echo 10 || echo "$sid")
    width=$([ "$sid" = "0" ] && echo 24 || echo 17)

    sketchybar --add item space.$sid left \
        --set space.$sid \
        background.color=0xffa6e3a1 \
        background.corner_radius=5 \
        background.height=20 \
        background.drawing=off \
        label="$label" \
        label.width=$width \
        label.padding_left=0 \
        label.padding_right=0 \
        click_script="aerospace workspace $sid"
done

sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off

# One app name per monitor (front_app.<display>), filled in by aerospace.sh
for display in $(aerospace list-monitors --format '%{monitor-appkit-nsscreen-screens-id}'); do
    sketchybar --add item front_app.$display left \
               --set front_app.$display display=$display icon.drawing=off
done

# Hidden item that places every workspace on its monitor's bar, highlights them and
# names the app on each monitor. Re-runs on app switches and windows opening/closing.
sketchybar --add item aerospace left \
           --set aerospace drawing=off script="$PLUGIN_DIR/aerospace.sh" \
           --subscribe aerospace aerospace_workspace_change front_app_switched \
                                 space_windows_change display_change system_woke

##### Adding Right Items #####
# Dividers between right items; calendar and media only show theirs while visible
# SketchyBar sizes "|" by its ink but draws it with the glyph's left bearing (~3px),
# so pad less on the left and more on the right to centre it between items
separator=(drawing=off icon.drawing=off icon.padding_left=0 icon.padding_right=0 label="|" label.color=0xff6c7086
           label.padding_left=5 label.padding_right=11)

sketchybar --add item clock right \
           --set clock update_freq=10 icon.drawing=off script="$PLUGIN_DIR/clock.sh" \
           --add item clock_sep right \
           --set clock_sep "${separator[@]}" drawing=on \
           --add item battery right \
           --set battery update_freq=120 icon.drawing=off script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item calendar_sep right \
           --set calendar_sep "${separator[@]}" \
           --add item calendar right \
           --set calendar update_freq=15 icon=󰃭 drawing=off \
                          script="$PLUGIN_DIR/calendar.sh" click_script="$PLUGIN_DIR/join_meeting.sh" \
           --subscribe calendar system_woke \
           --add item media_sep right \
           --set media_sep "${separator[@]}" \
           --add item media right \
           --set media update_freq=5 drawing=off label.max_chars=40 \
                       script="$PLUGIN_DIR/media.sh" click_script="media-control toggle-play-pause" \
           --subscribe media system_woke

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
